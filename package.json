{
  "name": "ertisauth-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:messages",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "check:messages": "node --conditions=development scripts/check-messages.mjs",
    "check:docs": "python3 scripts/docs/samples.py --all --check && python3 scripts/docs/error_codes.py --check",
    "docs:samples": "python3 scripts/docs/samples.py",
    "docs:error-codes": "python3 scripts/docs/error_codes.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
